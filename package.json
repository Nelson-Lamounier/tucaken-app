{
  "name": "tucaken-app",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "admin-api"
  ],
  "resolutions": {
    "@grpc/proto-loader/protobufjs": "^7.6.2",
    "@opentelemetry/otlp-transformer/protobufjs": "^8.5.0",
    "esbuild": "^0.28.1"
  },
  "imports": {},
  "scripts": {
    "dev": "vite dev --port 5001",
    "build": "vite build && esbuild src/server/patches.ts --bundle --platform=node --format=esm --outfile=server.js '--external:./dist/*' '--external:tanstack-start-*' '--external:#tanstack-*' '--external:@opentelemetry/*' '--external:pino' '--external:prom-client' '--external:@pyroscope/*' && esbuild src/lib/observability/telemetry.ts --bundle --platform=node --format=esm --outfile=telemetry.js '--external:@opentelemetry/*' '--external:@pyroscope/*'",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:cognito": "yarn dlx tsx scripts/setup-cognito-providers.ts",
    "update:cognito-prod": "yarn dlx tsx scripts/update-cognito-prod.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1039.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@grafana/faro-web-sdk": "^2.3.1",
    "@grafana/faro-web-tracing": "^2.3.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/mdx": "^3.1.1",
    "@number-flow/react": "^0.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@pyroscope/nodejs": "^0.4.5",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/zod-form-adapter": "latest",
    "dompurify": "^3.4.3",
    "html2canvas-pro": "^2.0.2",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.545.0",
    "mermaid": "^11.15.0",
    "motion": "^12.38.0",
    "motion-plus": "^1.5.1",
    "next-themes": "^0.4.6",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.1.1",
    "tailwindcss": "^4.2.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1039.0",
    "@aws-sdk/client-iam": "^3.1039.0",
    "@aws-sdk/client-lambda": "^3.1039.0",
    "@aws-sdk/client-sts": "^3.1039.0",
    "@aws-sdk/credential-providers": "^3.1039.0",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/intent": "^0.0.36",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.28.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.32.1",
    "vinxi": "^0.5.11",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  }
}
